# Content-hashed build output (images, CSS, JS, fonts). The filename changes
# whenever the content changes, so these are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static brand assets — change rarely, cache a week.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800
