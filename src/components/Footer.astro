---
import Marquee from './Marquee.astro';
import { PUBLIC_INSTAGRAM_HANDLE, PUBLIC_WHATSAPP_NUMBER } from 'astro:env/client';
import { whatsappLink, instagramLink } from '../lib/buyLinks';
import { TAGS } from '../lib/productTags';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
const wa = whatsappLink(PUBLIC_WHATSAPP_NUMBER, 'Hola!');
const ig = instagramLink(PUBLIC_INSTAGRAM_HANDLE);
---

<Marquee items={['HECHO A MANO', 'CERA DE SOJA', 'RESINA', 'MAR DEL PLATA']} />

<footer class="bg-[var(--color-blush)] text-[var(--color-ink)]">
  <div class="mx-auto grid max-w-[1400px] gap-10 px-5 py-12 md:grid-cols-4">
    <div>
      <Wordmark size="lg" color="var(--color-ink)" />
      <p class="mt-3 max-w-[24ch] text-sm opacity-80">
        Velas de cera de soja y accesorios de resina, hechos a mano.
      </p>
    </div>

    <div>
      <h2 class="label mb-3">Tienda</h2>
      <ul class="flex flex-col gap-2 text-sm">
        <li><a href="/shop">Todas las piezas</a></li>
        {TAGS.map((t) => (
          <li>
            <a href={`/shop?tag=${t.slug}`}>{t.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="label mb-3">Lumika</h2>
      <ul class="flex flex-col gap-2 text-sm">
        <li><a href="/about">Sobre nosotras</a></li>
        <li><a href="/contact">Contacto</a></li>
      </ul>
    </div>

    <div>
      <h2 class="label mb-3">Seguinos</h2>
      <ul class="flex flex-col gap-2 text-sm">
        <li><a href={ig} target="_blank" rel="noopener">Instagram ↗</a></li>
        <li><a href={wa} target="_blank" rel="noopener">WhatsApp ↗</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-ink)]/20">
    <div class="label mx-auto flex max-w-[1400px] justify-between px-5 py-4 opacity-70">
      <span>© {year} Lumika Objetos</span>
      <span>Mar del Plata</span>
    </div>
  </div>
</footer>
