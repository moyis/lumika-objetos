---
import { PUBLIC_WHATSAPP_NUMBER, PUBLIC_INSTAGRAM_HANDLE } from 'astro:env/client';
import { whatsappLink, instagramDmLink, orderMessage } from '../lib/buyLinks';

interface Props {
  productTitle: string;
  disabled?: boolean;
  fragrances?: string[];
}
const { productTitle, disabled = false, fragrances = [] } = Astro.props;
const hasFragrances = !disabled && fragrances.length > 0;
const wa = whatsappLink(
  PUBLIC_WHATSAPP_NUMBER,
  orderMessage(productTitle, hasFragrances ? fragrances[0] : undefined),
);
const ig = instagramDmLink(PUBLIC_INSTAGRAM_HANDLE);
---

{
  hasFragrances && (
    <fieldset class="mt-6" data-fragrance-group>
      <legend class="label mb-2">Fragancia</legend>
      <div class="flex flex-wrap gap-2">
        {fragrances.map((f, i) => (
          <label class="cursor-pointer">
            <input type="radio" name="fragrance" value={f} checked={i === 0} class="peer sr-only" />
            <span class="label inline-flex min-h-[44px] items-center rounded-full border-2 border-[var(--color-ink)] px-4 transition-colors peer-checked:border-[var(--color-blush)] peer-checked:bg-[var(--color-blush)] peer-checked:text-[var(--color-ink-fixed)] peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--color-blush)] peer-focus-visible:ring-offset-2 hover:border-[var(--color-blush)]">
              {f}
            </span>
          </label>
        ))}
      </div>
      <p data-fragrance-hint class="label mt-2 hidden text-[var(--color-ink)]">
        Elegí una fragancia para continuar
      </p>
    </fieldset>
  )
}

<div class="mt-6 flex flex-col gap-3 sm:flex-row">
  <a
    href={disabled ? undefined : wa}
    data-buy-wa
    data-wa-number={PUBLIC_WHATSAPP_NUMBER}
    data-product-title={productTitle}
    data-requires-fragrance={hasFragrances ? 'true' : 'false'}
    aria-disabled={disabled}
    rel="noopener"
    target="_blank"
    class={`inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 font-semibold tracking-wide focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-link)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-cream)]
      ${
        disabled
          ? 'bg-[var(--color-ink-fixed)]/30 text-[var(--color-cream-fixed)] cursor-not-allowed pointer-events-none'
          : 'btn-press bg-[var(--color-blue)] text-[var(--color-cream-fixed)] hover:opacity-90 transition-opacity'
      }`}
  >
    {disabled ? 'Agotado' : 'Pedir por WhatsApp'}
  </a>
  {
    !disabled && (
      <a
        href={ig}
        data-buy-ig
        data-product-title={productTitle}
        data-requires-fragrance={hasFragrances ? 'true' : 'false'}
        rel="noopener"
        target="_blank"
        class="btn-press inline-flex items-center justify-center gap-2 rounded-full btn-secondary px-6 py-3 font-semibold tracking-wide transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-link)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-cream)]"
      >
        Pedir por Instagram
      </a>
    )
  }
</div>

<!-- Instagram DMs can't be pre-filled, so ordering there is copy-then-paste. The
     button above is a plain link (works without JS: opens the DM). With JS we
     intercept the click to copy the order and explain the three steps in this
     dialog, so the user knows to paste instead of landing in an empty chat. -->
{
  !disabled && (
    <dialog
      data-ig-modal
      class="ig-modal w-[min(92vw,32rem)] rounded-2xl border-2 border-[var(--color-ink)] bg-[var(--color-cream)] p-0 text-[var(--color-ink)]"
      aria-labelledby="ig-modal-title"
    >
  <div class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <h2 id="ig-modal-title" class="h2">Pedí por Instagram</h2>
      <button
        type="button"
        data-ig-modal-close
        aria-label="Cerrar"
        class="label inline-flex min-h-[44px] min-w-[44px] items-center justify-center"
      >
        ✕
      </button>
    </div>

    <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink)]/70">
      Instagram no nos deja dejar el mensaje escrito, así que te copiamos el pedido. Son tres
      pasos:
    </p>

    <ol class="mt-4 space-y-2 leading-relaxed">
      <li>
        <span class="font-semibold text-[var(--color-link)]">1.</span> Tocá «Abrir Instagram»: te
        copiamos el pedido.
      </li>
      <li>
        <span class="font-semibold text-[var(--color-link)]">2.</span> En el chat, pegá el mensaje
        (mantené apretado y tocá «Pegar»).
      </li>
      <li>
        <span class="font-semibold text-[var(--color-link)]">3.</span> Enviá y te respondemos.
      </li>
    </ol>

    <p class="label mt-5 mb-1">Tu pedido</p>
    <p
      data-ig-modal-text
      class="rounded-md border-2 border-[var(--color-ink)] bg-[var(--color-surface-2)]/40 px-3 py-2 text-sm font-medium break-words"
    ></p>
    <p data-ig-modal-copied class="mt-2 hidden text-sm font-semibold text-[var(--color-ink)]">
      ✓ Copiado. Ya lo podés pegar en el chat.
    </p>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a
        data-ig-modal-open
        href={ig}
        target="_blank"
        rel="noopener"
        autofocus
        class="inline-flex flex-1 items-center justify-center gap-2 rounded-full btn-secondary px-6 py-3 font-semibold tracking-wide transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-link)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-cream)]"
      >
        Abrir Instagram
      </a>
      <button
        type="button"
        data-ig-modal-copy
        class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-[var(--color-ink)] px-6 py-3 font-semibold tracking-wide transition-colors hover:bg-[var(--color-ink)] hover:text-[var(--color-cream)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-ink)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-cream)]"
      >
        Copiar de nuevo
      </button>
    </div>
  </div>
    </dialog>
  )
}

<style>
  .ig-modal {
    margin: auto;
  }
  .ig-modal::backdrop {
    background: color-mix(in oklab, var(--color-ink-fixed) 55%, transparent);
  }
</style>

<script>
  function setupBuyButtons() {
    const wa = document.querySelector('[data-buy-wa]') as HTMLAnchorElement | null;
    const ig = document.querySelector('[data-buy-ig]') as HTMLAnchorElement | null;
    if (!wa && !ig) return;

    const ref = wa ?? ig!;
    const title = ref.dataset.productTitle ?? '';
    const number = wa?.dataset.waNumber ?? '';
    const requiresFragrance = ref.dataset.requiresFragrance === 'true';

    const radios = document.querySelectorAll<HTMLInputElement>('input[name="fragrance"]');
    const hint = document.querySelector('[data-fragrance-hint]') as HTMLElement | null;
    const modal = document.querySelector('[data-ig-modal]') as HTMLDialogElement | null;
    const modalText = document.querySelector('[data-ig-modal-text]') as HTMLElement | null;
    const modalCopied = document.querySelector('[data-ig-modal-copied]') as HTMLElement | null;
    const modalOpen = document.querySelector('[data-ig-modal-open]') as HTMLAnchorElement | null;
    const modalCopy = document.querySelector('[data-ig-modal-copy]') as HTMLButtonElement | null;
    const modalClose = document.querySelector('[data-ig-modal-close]') as HTMLElement | null;

    const selected = () =>
      document.querySelector<HTMLInputElement>('input[name="fragrance"]:checked')?.value ?? '';

    const message = (fragrance: string) =>
      fragrance
        ? `Hola, quiero pedir "${title}" con fragancia "${fragrance}"`
        : `Hola, quiero pedir "${title}"`;

    const sync = () => {
      if (wa) wa.href = `https://wa.me/${number}?text=${encodeURIComponent(message(selected()))}`;
    };

    // Returns true if the order made it to the clipboard. On failure the order
    // text stays visible in the modal for manual copy, so we don't claim success.
    const copyOrder = async () => {
      try {
        await navigator.clipboard.writeText(message(selected()));
        modalCopied?.classList.remove('hidden');
        return true;
      } catch {
        modalCopied?.classList.add('hidden');
        return false;
      }
    };

    radios.forEach((r) =>
      r.addEventListener('change', () => {
        sync();
        if (selected()) hint?.classList.add('hidden');
        modalCopied?.classList.add('hidden');
        if (modalText) modalText.textContent = message(selected());
      }),
    );

    const guardFragrance = (e: Event) => {
      if (requiresFragrance && !selected()) {
        e.preventDefault();
        hint?.classList.remove('hidden');
        radios[0]?.focus();
        return false;
      }
      return true;
    };

    wa?.addEventListener('click', guardFragrance);

    ig?.addEventListener('click', (e) => {
      if (!guardFragrance(e)) return;
      // No <dialog> support: let the link open the DM (the copy-paste hint is
      // lost, but the chat still opens).
      if (!modal || typeof modal.showModal !== 'function') return;
      e.preventDefault();
      if (modalText) modalText.textContent = message(selected());
      modalCopied?.classList.add('hidden');
      copyOrder();
      modal.showModal();
    });

    modalOpen?.addEventListener('click', () => {
      copyOrder();
      modal?.close();
    });
    modalCopy?.addEventListener('click', () => {
      copyOrder();
    });
    modalClose?.addEventListener('click', () => modal?.close());
    // Click on the backdrop (the dialog's own box, outside the inner panel) closes.
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    sync();
  }

  setupBuyButtons();
  document.addEventListener('astro:page-load', setupBuyButtons);
</script>
