---
import { PUBLIC_WHATSAPP_NUMBER, PUBLIC_INSTAGRAM_HANDLE } from 'astro:env/client';
import { whatsappLink, instagramDmLink, orderMessage } from '../lib/buyLinks';

interface Props {
  productTitle: string;
  disabled?: boolean;
  fragrances?: string[];
}
const { productTitle, disabled = false, fragrances = [] } = Astro.props;
const hasFragrances = !disabled && fragrances.length > 0;
const wa = whatsappLink(
  PUBLIC_WHATSAPP_NUMBER,
  orderMessage(productTitle, hasFragrances ? fragrances[0] : undefined),
);
const ig = instagramDmLink(PUBLIC_INSTAGRAM_HANDLE);
---

{
  hasFragrances && (
    <fieldset class="mt-6" data-fragrance-group>
      <legend class="label mb-2">Fragancia</legend>
      <div class="flex flex-wrap gap-2">
        {fragrances.map((f, i) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="fragrance"
              value={f}
              checked={i === 0}
              class="peer sr-only"
            />
            <span class="label inline-block rounded-full border-2 border-[var(--color-ink)] px-4 py-2 transition-colors hover:border-[var(--color-blush)] peer-checked:border-[var(--color-blush)] peer-checked:bg-[var(--color-blush)] peer-checked:text-[var(--color-ink)] peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--color-blush)] peer-focus-visible:ring-offset-2">
              {f}
            </span>
          </label>
        ))}
      </div>
      <p data-fragrance-hint class="label mt-2 hidden text-[var(--color-pink)]">
        Elegí una fragancia para continuar
      </p>
    </fieldset>
  )
}

<div class="mt-6 flex flex-col gap-3 sm:flex-row">
  <a
    href={disabled ? undefined : wa}
    data-buy-wa
    data-wa-number={PUBLIC_WHATSAPP_NUMBER}
    data-product-title={productTitle}
    data-requires-fragrance={hasFragrances ? 'true' : 'false'}
    aria-disabled={disabled}
    rel="noopener"
    target="_blank"
    class={`inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 font-semibold tracking-wide
      ${
        disabled
          ? 'bg-[var(--color-ink)]/30 text-[var(--color-cream)] cursor-not-allowed pointer-events-none'
          : 'bg-[var(--color-blue)] text-[var(--color-cream)] hover:opacity-90 transition-opacity'
      }`}
  >
    {disabled ? 'Agotado' : 'Pedir por WhatsApp'}
  </a>
  <a
    href={ig}
    data-buy-ig
    data-product-title={productTitle}
    data-requires-fragrance={hasFragrances ? 'true' : 'false'}
    rel="noopener"
    target="_blank"
    class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--color-pink)] px-6 py-3 font-semibold tracking-wide text-[var(--color-ink)] transition-opacity hover:opacity-90"
  >
    Pedir por Instagram
  </a>
</div>

<p data-ig-copied class="label mt-3 hidden text-[var(--color-blue)]">
  Mensaje copiado ✓ — pegalo en el chat de Instagram
</p>

<script>
  function setupBuyButtons() {
    const wa = document.querySelector('[data-buy-wa]') as HTMLAnchorElement | null;
    const ig = document.querySelector('[data-buy-ig]') as HTMLAnchorElement | null;
    if (!wa && !ig) return;

    const ref = wa ?? ig!;
    const title = ref.dataset.productTitle ?? '';
    const number = wa?.dataset.waNumber ?? '';
    const requiresFragrance = ref.dataset.requiresFragrance === 'true';

    const radios = document.querySelectorAll<HTMLInputElement>('input[name="fragrance"]');
    const hint = document.querySelector('[data-fragrance-hint]') as HTMLElement | null;
    const copied = document.querySelector('[data-ig-copied]') as HTMLElement | null;

    const selected = () =>
      document.querySelector<HTMLInputElement>('input[name="fragrance"]:checked')?.value ?? '';

    const message = (fragrance: string) =>
      fragrance
        ? `Hola, quiero pedir "${title}" con fragancia "${fragrance}"`
        : `Hola, quiero pedir "${title}"`;

    const sync = () => {
      if (wa) wa.href = `https://wa.me/${number}?text=${encodeURIComponent(message(selected()))}`;
    };

    radios.forEach((r) =>
      r.addEventListener('change', () => {
        sync();
        if (selected()) hint?.classList.add('hidden');
        copied?.classList.add('hidden');
      }),
    );

    const guardFragrance = (e: Event) => {
      if (requiresFragrance && !selected()) {
        e.preventDefault();
        hint?.classList.remove('hidden');
        radios[0]?.focus();
        return false;
      }
      return true;
    };

    wa?.addEventListener('click', guardFragrance);

    ig?.addEventListener('click', async (e) => {
      if (!guardFragrance(e)) return;
      try {
        await navigator.clipboard.writeText(message(selected()));
        copied?.classList.remove('hidden');
      } catch {
        // Clipboard unavailable (e.g. insecure context) — DM still opens.
      }
    });

    sync();
  }

  setupBuyButtons();
  document.addEventListener('astro:page-load', setupBuyButtons);
</script>
