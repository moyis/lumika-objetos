---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { whatsappLink } from '../lib/buyLinks';
import { WHATSAPP_NUMBER } from '../lib/site';

interface Props {
  image: ImageMetadata;
  // Must match the preload `imagesizes` in Layout so the preloaded AVIF and the
  // rendered <source> resolve to the same file (single fetch, no waste).
  sizes: string;
}
const { image, sizes } = Astro.props;

const wa = whatsappLink(WHATSAPP_NUMBER, 'Hola! Quiero hacer un pedido');

// Build the hero variants here (instead of <Picture>) so the AVIF call is byte
// -for-byte identical to Layout's preload getImage — same args, same hashed
// files, so the preload is a guaranteed cache hit. <Picture> processes its
// sources differently and would emit different hashes than the preload.
const avif = await getImage({ src: image, format: 'avif', width: 1600, sizes });
const webp = await getImage({ src: image, format: 'webp', width: 1600, sizes });
const height = Math.round((1600 * image.height) / image.width);
---

<section class="relative overflow-hidden border-b-2 border-[var(--color-ink)]">
  <div class="grid items-stretch md:grid-cols-[minmax(0,5fr)_8fr]">
    <div
      class="order-last flex flex-col justify-center px-5 py-12 md:order-first md:py-20 md:pr-10 md:gutter-l"
    >
      <div class="label">
        <span>Mar del Plata</span>
      </div>

      <h1 class="display-2 mt-8">
        Velas <em class="text-[var(--color-link)] italic">&amp;</em><br />
        <span class="wavy-underline">Resina</span>
      </h1>

      <p class="mt-6 max-w-[40ch] text-base leading-relaxed">
        Color, brillo y textura en pequeñas ediciones hechas a mano en Mar del Plata. Velas de cera
        de soja y piezas de resina para decorar, usar y disfrutar.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/shop"
          class="inline-flex min-h-11 items-center gap-2 rounded-full bg-[var(--color-blue)] px-6 py-3 font-semibold tracking-wide text-[var(--color-cream-fixed)] transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-link)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-cream)]"
          >Ver tienda →</a
        >
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-[var(--color-ink)] px-6 py-3 font-semibold tracking-wide text-[var(--color-ink)] transition-colors hover:bg-[var(--color-ink)] hover:text-[var(--color-cream)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-ink)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-cream)]"
          >Pedir por WhatsApp</a
        >
      </div>
    </div>

    <div class="order-first md:order-last">
      <picture class="contents">
        <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
        <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
        <img
          src={webp.src}
          srcset={webp.srcSet.attribute}
          sizes={sizes}
          width={1600}
          height={height}
          alt="Set de velas y llaveros Lumika"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[4/3] h-full w-full border-x-2 border-[var(--color-ink)] object-cover md:aspect-auto md:min-h-[560px]"
        />
      </picture>
    </div>
  </div>
</section>
