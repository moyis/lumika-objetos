---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/vella-y-llaveros.webp';

const year = new Date().getFullYear();
---

<section class="relative overflow-hidden border-b-2 border-[var(--color-ink)]">
  <div class="grid items-stretch md:grid-cols-[minmax(0,5fr)_8fr]">
    <div
      class="order-last flex flex-col justify-center px-5 py-12 md:order-first md:py-20 md:pr-10 md:pl-[max(1.25rem,calc((100vw-1400px)/2))]"
    >
      <div class="label flex justify-between">
        <span>Vol. 01 · {year}</span>
        <span>Mar del Plata</span>
      </div>

      <h1 class="display-2 mt-8">
        Velas <em class="text-[var(--color-blue)] italic">+</em><br />
        <span class="wavy-underline">resina.</span>
      </h1>

      <p class="mt-6 max-w-[40ch] text-base leading-relaxed">
        Objetos hechos a mano, en ediciones chicas. Velas de soja, accesorios de resina, piezas
        únicas pensadas y vertidas en Mar del Plata.
      </p>

      <div class="mt-8 flex items-center gap-4">
        <a
          href="/shop"
          class="inline-flex items-center gap-2 rounded-full bg-[var(--color-blue)] px-6 py-3 font-semibold tracking-wide text-[var(--color-cream)] transition-opacity hover:opacity-90"
          >Ver tienda →</a
        >
        <div class="hidden gap-2 md:flex">
          <span class="block h-6 w-6 rounded-full bg-[var(--color-pink)]"></span>
          <span class="block h-6 w-6 rounded-full bg-[var(--color-blue)]"></span>
          <span class="block h-6 w-6 rounded-full bg-[var(--color-blush)]"></span>
        </div>
      </div>
    </div>

    <div class="order-first md:order-last">
      <Image
        src={heroImage}
        alt="Set de velas y llaveros Lumika"
        widths={[720, 1080, 1600]}
        sizes="(min-width: 768px) 62vw, 100vw"
        class="aspect-[4/3] h-full w-full object-cover md:aspect-auto md:min-h-[560px]"
        loading="eager"
      />
    </div>
  </div>
</section>
