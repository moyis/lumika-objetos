---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
  slug: string;
}
const { images, alt, slug } = Astro.props;
const [hero, ...rest] = images;

const fullImages = await Promise.all(
  images.map((img) => getImage({ src: img, width: 2000 })),
);
const lightboxSrcs = fullImages.map((img) => img.src);
---

{
  hero && (
    <div class="space-y-4">
      <button
        type="button"
        class="lightbox-trigger block w-full cursor-zoom-in"
        data-index="0"
        aria-label="Ver imagen en pantalla completa"
      >
        <Image
          src={hero}
          alt={alt}
          widths={[800, 1200, 2000]}
          sizes="(min-width: 1024px) 60vw, 100vw"
          class="aspect-[4/5] w-full rounded-md border-2 border-[var(--color-ink)] object-cover"
          transition:name={`product-image-${slug}`}
        />
      </button>
      {rest.length > 0 && (
        <div class="grid grid-cols-2 gap-4">
          {rest.map((img, i) => (
            <button
              type="button"
              class="lightbox-trigger block w-full cursor-zoom-in"
              data-index={i + 1}
              aria-label="Ver imagen en pantalla completa"
            >
              <Image
                src={img}
                alt={`${alt} — detalle ${i + 2}`}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 30vw, 50vw"
                class="aspect-square w-full rounded-md border-2 border-[var(--color-ink)] object-cover"
                loading="lazy"
              />
            </button>
          ))}
        </div>
      )}

      <div
        class="lightbox fixed inset-0 z-[100] hidden items-center justify-center bg-[var(--color-ink)]/90 p-4"
        role="dialog"
        aria-modal="true"
        aria-label="Galería de imágenes"
      >
        <button
          type="button"
          class="lightbox-close absolute top-4 right-4 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[var(--color-cream)] text-2xl text-[var(--color-cream)]"
          aria-label="Cerrar"
        >
          ✕
        </button>
        {images.length > 1 && (
          <button
            type="button"
            class="lightbox-prev absolute top-1/2 left-4 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[var(--color-cream)] text-2xl text-[var(--color-cream)]"
            aria-label="Anterior"
          >
            ‹
          </button>
        )}
        <img class="lightbox-img max-h-[90vh] max-w-full rounded-md object-contain" alt={alt} />
        {images.length > 1 && (
          <button
            type="button"
            class="lightbox-next absolute top-1/2 right-4 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[var(--color-cream)] text-2xl text-[var(--color-cream)]"
            aria-label="Siguiente"
          >
            ›
          </button>
        )}
      </div>
    </div>
  )
}

<script define:vars={{ lightboxSrcs }}>
  document.querySelectorAll('.lightbox-trigger').forEach((trigger) => {
    const lightbox = trigger.closest('.space-y-4')?.querySelector('.lightbox');
    if (!lightbox) return;

    const imgEl = lightbox.querySelector('.lightbox-img');
    let current = 0;

    const show = (i) => {
      current = (i + lightboxSrcs.length) % lightboxSrcs.length;
      imgEl.src = lightboxSrcs[current];
    };

    const open = (i) => {
      show(i);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    };

    trigger.addEventListener('click', () =>
      open(Number(trigger.getAttribute('data-index'))),
    );

    lightbox.querySelector('.lightbox-close')?.addEventListener('click', close);
    lightbox
      .querySelector('.lightbox-prev')
      ?.addEventListener('click', () => show(current - 1));
    lightbox
      .querySelector('.lightbox-next')
      ?.addEventListener('click', () => show(current + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  });
</script>
