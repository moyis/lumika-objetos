---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
}
const { images, alt } = Astro.props;
const [hero, ...rest] = images;
---

{
  hero && (
    <div class="space-y-4">
      <button
        type="button"
        class="lightbox-trigger block w-full cursor-zoom-in"
        data-index="0"
        aria-label="Ver imagen en pantalla completa"
      >
        <Picture
          src={hero}
          alt={alt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          width={1660}
          quality={62}
          sizes="(min-width: 1400px) 820px, (min-width: 1024px) 60vw, 100vw"
          pictureAttributes={{ class: 'contents' }}
          class="aspect-[4/5] w-full rounded-md border-2 border-[var(--color-ink)] object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </button>
      {rest.length > 0 && (
        <div class="grid grid-cols-2 gap-4">
          {rest.map((img, i) => (
            <button
              type="button"
              class="lightbox-trigger block w-full cursor-zoom-in"
              data-index={i + 1}
              aria-label="Ver imagen en pantalla completa"
            >
              <Picture
                src={img}
                alt={`${alt}, detalle ${i + 2}`}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                width={500}
                quality={55}
                sizes="(min-width: 1400px) 400px, (min-width: 1024px) 30vw, 50vw"
                pictureAttributes={{ class: 'contents' }}
                class="aspect-square w-full rounded-md border-2 border-[var(--color-ink)] object-cover"
                loading="lazy"
              />
            </button>
          ))}
        </div>
      )}

      <div
        class="lightbox fixed inset-0 z-overlay hidden items-center justify-center bg-[var(--color-ink)]/90 p-4"
        role="dialog"
        aria-modal="true"
        aria-label="Galería de imágenes"
      >
        <button
          type="button"
          class="lightbox-close absolute top-4 right-4 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[var(--color-cream)] text-2xl text-[var(--color-cream)]"
          aria-label="Cerrar"
        >
          ✕
        </button>
        {images.length > 1 && (
          <button
            type="button"
            class="lightbox-prev absolute top-1/2 left-4 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[var(--color-cream)] text-2xl text-[var(--color-cream)]"
            aria-label="Anterior"
          >
            ‹
          </button>
        )}
        {images.map((img, i) => (
          <Picture
            src={img}
            alt={alt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            width={1600}
            quality={68}
            sizes="100vw"
            pictureAttributes={{ class: 'contents' }}
            data-lightbox-slide={i}
            class={`lightbox-img max-h-[90vh] max-w-full rounded-md object-contain ${i !== 0 ? 'hidden' : ''}`}
            loading="lazy"
          />
        ))}
        {images.length > 1 && (
          <button
            type="button"
            class="lightbox-next absolute top-1/2 right-4 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[var(--color-cream)] text-2xl text-[var(--color-cream)]"
            aria-label="Siguiente"
          >
            ›
          </button>
        )}
      </div>
    </div>
  )
}

<script>
  function setupGallery() {
    // One gallery (and one .lightbox) per product page. Anchor on the bespoke
    // .lightbox class, not the generic .space-y-4 wrapper.
    const lightbox = document.querySelector('.lightbox');
    const root = lightbox?.parentElement;
    if (!lightbox || !root) return;

    const slides = lightbox.querySelectorAll('[data-lightbox-slide]');
    const closeBtn = lightbox.querySelector<HTMLElement>('.lightbox-close');
    const triggers = root.querySelectorAll('.lightbox-trigger');
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((slide, idx) => slide.classList.toggle('hidden', idx !== current));
    };

    // Bound once and attached only while open, so it never accumulates across
    // navigations or duplicates per thumbnail.
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') return close();
      if (e.key === 'ArrowLeft') return show(current - 1);
      if (e.key === 'ArrowRight') return show(current + 1);
      if (e.key === 'Tab') {
        // Trap focus on the visible controls inside the open lightbox.
        const items = lightbox.querySelectorAll<HTMLElement>('button:not([disabled])');
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    const open = (i: number, openedBy: HTMLElement) => {
      opener = openedBy;
      show(i);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);
      closeBtn?.focus();
    };

    const close = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      opener?.focus();
      opener = null;
    };

    // Per-trigger: open only. Nav/close controls are bound once each below.
    triggers.forEach((trigger) =>
      trigger.addEventListener('click', () =>
        open(Number(trigger.getAttribute('data-index')), trigger as HTMLElement),
      ),
    );

    closeBtn?.addEventListener('click', close);
    lightbox.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
    lightbox.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
  }

  setupGallery();
  document.addEventListener('astro:page-load', setupGallery);
</script>
