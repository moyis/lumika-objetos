---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Cambiar a modo oscuro"
  aria-pressed="false"
  class:list={[
    'theme-toggle inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full text-[var(--color-ink)] transition-colors hover:text-[var(--color-link)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-link)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-cream)]',
    className,
  ]}
>
  {/* Moon shows in light mode (tap → dark); Sun shows in dark mode (tap → light). */}
  <svg
    class="theme-icon-moon h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
  </svg>
  <svg
    class="theme-icon-sun h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<style is:global>
  .theme-icon-sun {
    display: none;
  }
  html[data-theme='dark'] .theme-icon-moon {
    display: none;
  }
  html[data-theme='dark'] .theme-icon-sun {
    display: inline-block;
  }
  /* The icon snaps on press (tactile, matches .btn-press); the page colors don't
     crossfade — animating the whole field cream↔ink reads as muddy, not crisp. */
  .theme-toggle svg {
    transition: transform 0.2s var(--ease-out-quart);
  }
  .theme-toggle:active svg {
    transform: rotate(-25deg) scale(0.88);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg,
    .theme-toggle:active svg {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  type Theme = 'light' | 'dark';

  function applyTheme(theme: Theme) {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* storage blocked (private mode): the choice just won't persist */
    }
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#fff8d9');
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(theme === 'dark'));
      b.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro',
      );
    });
  }

  function setupThemeToggle() {
    const toggles = document.querySelectorAll('[data-theme-toggle]');
    if (!toggles.length) return;
    const current = (document.documentElement.dataset.theme as Theme) || 'light';
    toggles.forEach((b) => {
      b.setAttribute('aria-pressed', String(current === 'dark'));
      b.setAttribute(
        'aria-label',
        current === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro',
      );
      b.addEventListener('click', () =>
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'),
      );
    });
    // Follow the OS setting until the visitor makes an explicit choice (then it persists).
    try {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (localStorage.getItem('theme')) return;
        applyTheme(e.matches ? 'dark' : 'light');
      });
    } catch {
      /* matchMedia unsupported: stick with whatever the inline script set */
    }
  }

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
