---
import Isotype from './Isotype.astro';
import MobileMenu from './MobileMenu.astro';

const navLinks = [
  { href: '/shop', label: 'Tienda' },
  { href: '/about', label: 'Sobre nosotras' },
  { href: '/contact', label: 'Contacto' },
];
---

<header class="sticky top-0 z-40 border-b-2 border-[var(--color-ink)] bg-[var(--color-cream)]">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between px-5 py-4">
    <Isotype size="lg" />

    <nav class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a href={link.href} class="label transition-colors hover:text-[var(--color-blue)]">
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="inline-flex flex-col gap-1.5 p-2 md:hidden"
      aria-label="Abrir menú"
      data-mobile-menu-trigger
    >
      <span class="h-0.5 w-6 bg-[var(--color-ink)]"></span>
      <span class="h-0.5 w-6 bg-[var(--color-ink)]"></span>
      <span class="h-0.5 w-6 bg-[var(--color-ink)]"></span>
    </button>
  </div>
</header>

<MobileMenu />
