---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import PriceDisplay from './PriceDisplay.astro';

interface Props {
  product: CollectionEntry<'products'>;
  // Responsive sizes hint matching the rendered column width. Defaults to a
  // 3-column layout (used by the related-products grid on product pages).
  sizes?: string;
  // Eager-load + high fetch priority for above-the-fold cards (LCP candidate).
  priority?: boolean;
}
const {
  product,
  sizes = '(min-width: 1400px) 450px, (min-width: 768px) 33vw, 50vw',
  priority = false,
} = Astro.props;
const { title, slug, subtitle, price, stock, tags, images } = product.data;
const cover = images[0];
const soldOut = stock === 0;
---

<a
  href={`/shop/${slug}`}
  data-product-tags={tags.join(',')}
  class="group block rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-blue)]"
>
  <div
    class="relative aspect-[4/5] overflow-hidden rounded-md border-2 border-[var(--color-ink)] bg-[var(--color-blush)]"
  >
    {
      cover && (
        <Picture
          src={cover}
          alt={subtitle ? `${title}, ${subtitle}` : title}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          width={700}
          quality={55}
          sizes={sizes}
          pictureAttributes={{ class: 'contents' }}
          class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
        />
      )
    }
    {
      soldOut && (
        <span class="label absolute top-3 left-3 rounded bg-[var(--color-ink)] px-2 py-1 text-[var(--color-cream)]">
          Agotado
        </span>
      )
    }
  </div>
  <div class="pt-3">
    <h3 class="wavy-underline inline text-2xl leading-tight font-[var(--font-display)] md:text-3xl">
      {title}
    </h3>
    {subtitle && <p class="mt-1 text-sm leading-snug text-[var(--color-ink)]/70">{subtitle}</p>}
    <p class="mt-1.5">
      <PriceDisplay value={price} size="sm" />
    </p>
  </div>
</a>
