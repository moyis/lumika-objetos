---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import PriceDisplay from './PriceDisplay.astro';

interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const { title, slug, subtitle, price, stock, tags, images } = product.data;
const cover = images[0];
const soldOut = stock === 0;
---

<a
  href={`/shop/${slug}`}
  data-product-tags={tags.join(',')}
  class="group block rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-blue)]"
>
  <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-[var(--color-blush)]">
    {
      cover && (
        <Image
          src={cover}
          alt={title}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
          class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
          loading="lazy"
        />
      )
    }
    {
      soldOut && (
        <span class="label absolute top-3 left-3 rounded bg-[var(--color-ink)] px-2 py-1 text-[var(--color-cream)]">
          Agotado
        </span>
      )
    }
  </div>
  <div class="pt-3">
    <h3 class="wavy-underline inline text-lg leading-tight font-[var(--font-display)]">{title}</h3>
    {subtitle && <p class="label mt-1 opacity-70">{subtitle}</p>}
    <p class="mt-1.5"><PriceDisplay value={price} size="sm" /></p>
  </div>
</a>
