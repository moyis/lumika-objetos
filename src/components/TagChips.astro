---
import { TAGS } from '../lib/productTags';
---

<div
  data-tag-chips
  class="sticky top-[var(--header-h)] z-sticky border-b-2 border-[var(--color-ink)] bg-[var(--color-cream)] py-3"
>
  <div class="mx-auto flex max-w-[1400px] gap-2 overflow-x-auto px-5">
    <button
      type="button"
      data-tag="__all"
      aria-pressed="false"
      class="chip label inline-flex min-h-[44px] items-center rounded-full border-2 border-[var(--color-ink)] px-4 whitespace-nowrap"
      >Todo</button
    >
    {
      TAGS.map((tag) => (
        <button
          type="button"
          data-tag={tag.slug}
          aria-pressed="false"
          class="chip label inline-flex min-h-[44px] items-center rounded-full border-2 border-[var(--color-ink)] px-4 whitespace-nowrap"
        >
          {tag.label}
        </button>
      ))
    }
  </div>
</div>

<style>
  /* Promo chip carries a blush fill so it reads as a promotion against the
     row of cream chips. Ink text keeps it legible; selecting it falls through
     to the shared ink-fill active state below. */
  .chip[data-tag='promos'] {
    background: var(--color-blush);
    color: var(--color-ink-fixed);
  }

  .chip[data-active='true'] {
    background: var(--color-ink);
    color: var(--color-cream);
  }
</style>

<script>
  type TagState = Set<string>;

  function readTagsFromUrl(): TagState {
    const params = new URLSearchParams(window.location.search);
    return new Set(params.getAll('tag'));
  }

  function writeTagsToUrl(tags: TagState) {
    const params = new URLSearchParams();
    [...tags].forEach((t) => params.append('tag', t));
    const qs = params.toString();
    const url = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    history.replaceState({}, '', url);
  }

  function applyFilter(tags: TagState) {
    const cards = document.querySelectorAll<HTMLElement>('[data-product-tags]');
    cards.forEach((card) => {
      const cardTags = (card.dataset.productTags ?? '').split(',').filter(Boolean);
      const visible = tags.size === 0 || [...tags].some((t) => cardTags.includes(t));
      card.style.display = visible ? '' : 'none';
    });
    const visibleCount = [...cards].filter((c) => c.style.display !== 'none').length;
    const empty = document.querySelector<HTMLElement>('[data-empty-state]');
    if (empty) empty.style.display = visibleCount > 0 ? 'none' : '';

    // Keep the "Tienda · N piezas" header in sync with the active filter.
    const countEl = document.querySelector<HTMLElement>('[data-product-count]');
    const nounEl = document.querySelector<HTMLElement>('[data-product-noun]');
    if (countEl) countEl.textContent = String(visibleCount);
    if (nounEl) nounEl.textContent = visibleCount === 1 ? 'pieza' : 'piezas';
    document.querySelectorAll<HTMLElement>('.chip').forEach((btn) => {
      const t = btn.dataset.tag ?? '';
      const active = t === '__all' ? tags.size === 0 : tags.has(t);
      btn.dataset.active = String(active);
      btn.setAttribute('aria-pressed', String(active));
    });
  }

  function setup() {
    const tags = readTagsFromUrl();
    applyFilter(tags);
    document.querySelectorAll<HTMLElement>('.chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = btn.dataset.tag ?? '';
        if (t === '__all' || tags.has(t)) {
          tags.clear();
        } else {
          tags.clear();
          tags.add(t);
        }
        writeTagsToUrl(tags);
        applyFilter(tags);
      });
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
