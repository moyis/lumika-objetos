---
import Wordmark from './Wordmark.astro';
import { PUBLIC_INSTAGRAM_HANDLE } from 'astro:env/client';
import { whatsappLink, instagramLink } from '../lib/buyLinks';
import { WHATSAPP_NUMBER } from '../lib/site';

const wa = whatsappLink(WHATSAPP_NUMBER, 'Hola!');
const ig = instagramLink(PUBLIC_INSTAGRAM_HANDLE);

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/shop', label: 'Tienda' },
  { href: '/about', label: 'Sobre nosotras' },
  { href: '/contact', label: 'Contacto' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<div
  id="mobile-menu"
  data-mobile-menu
  class="fixed inset-0 z-modal hidden flex-col bg-[var(--color-cream)] p-6"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
>
  <div class="mb-12 flex items-center justify-between">
    <Wordmark size="sm" />
    <button
      type="button"
      class="label inline-flex min-h-[44px] items-center p-2"
      aria-label="Cerrar menú"
      data-mobile-menu-close>Cerrar ✕</button
    >
  </div>

  <nav class="flex flex-col gap-6 text-5xl leading-none font-[var(--font-display)]">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          data-mobile-menu-link
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[isActive(link.href) && 'text-[var(--color-link)]']}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="mt-auto border-t-2 border-[var(--color-ink)] pt-12">
    <div class="mb-4 flex gap-3">
      <span class="block h-6 w-6 rounded-full bg-[var(--color-pink)]"></span>
      <span class="block h-6 w-6 rounded-full bg-[var(--color-blue)]"></span>
      <span class="block h-6 w-6 rounded-full bg-[var(--color-blush)]"></span>
    </div>
    <div class="label flex gap-4">
      <a href={wa} target="_blank" rel="noopener">WhatsApp ↗</a>
      <a href={ig} target="_blank" rel="noopener">Instagram ↗</a>
    </div>
  </div>
</div>

<script>
  function setup() {
    const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
    const trigger = document.querySelector('[data-mobile-menu-trigger]') as HTMLElement | null;
    const closeBtn = document.querySelector('[data-mobile-menu-close]');
    const links = document.querySelectorAll('[data-mobile-menu-link]');
    if (!menu || !trigger || !closeBtn) return;

    const focusables = () =>
      menu.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );

    const open = () => {
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      document.body.style.overflow = 'hidden';
      trigger.setAttribute('aria-expanded', 'true');
      focusables()[0]?.focus();
    };
    const close = () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      document.body.style.overflow = '';
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    };

    trigger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    links.forEach((l) => l.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (menu.classList.contains('hidden')) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      // Trap focus within the open dialog.
      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
