---
import Wordmark from './Wordmark.astro';
import { PUBLIC_INSTAGRAM_HANDLE, PUBLIC_WHATSAPP_NUMBER } from 'astro:env/client';
import { whatsappLink, instagramLink } from '../lib/buyLinks';

const wa = whatsappLink(PUBLIC_WHATSAPP_NUMBER, 'Hola!');
const ig = instagramLink(PUBLIC_INSTAGRAM_HANDLE);
---

<div
  data-mobile-menu
  class="fixed inset-0 z-50 hidden flex-col bg-[var(--color-cream)] p-6"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
>
  <div class="mb-12 flex items-center justify-between">
    <Wordmark size="sm" />
    <button type="button" class="label p-2" aria-label="Cerrar menú" data-mobile-menu-close
      >Cerrar ✕</button
    >
  </div>

  <nav class="flex flex-col gap-6 text-5xl leading-none font-[var(--font-display)]">
    <a href="/" data-mobile-menu-link>Inicio</a>
    <a href="/shop" data-mobile-menu-link>Tienda</a>
    <a href="/about" data-mobile-menu-link>Sobre nosotras</a>
    <a href="/contact" data-mobile-menu-link>Contacto</a>
  </nav>

  <div class="mt-auto border-t-2 border-[var(--color-ink)] pt-12">
    <div class="mb-4 flex gap-3">
      <span class="block h-6 w-6 rounded-full bg-[var(--color-pink)]"></span>
      <span class="block h-6 w-6 rounded-full bg-[var(--color-blue)]"></span>
      <span class="block h-6 w-6 rounded-full bg-[var(--color-blush)]"></span>
    </div>
    <div class="label flex gap-4">
      <a href={wa} target="_blank" rel="noopener">WhatsApp ↗</a>
      <a href={ig} target="_blank" rel="noopener">Instagram ↗</a>
    </div>
  </div>
</div>

<script>
  function setup() {
    const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
    const trigger = document.querySelector('[data-mobile-menu-trigger]');
    const closeBtn = document.querySelector('[data-mobile-menu-close]');
    const links = document.querySelectorAll('[data-mobile-menu-link]');
    if (!menu || !trigger || !closeBtn) return;

    const open = () => {
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      document.body.style.overflow = '';
    };

    trigger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    links.forEach((l) => l.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) close();
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
