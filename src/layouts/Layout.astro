---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import brandOgImage from '../assets/images/vella-y-llaveros.webp';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
}
const {
  title,
  description = 'Velas de soja y accesorios de resina hechos a mano en Mar del Plata. Piezas unicas en ediciones cortas. Compra por WhatsApp.',
  image,
} = Astro.props;
const fullTitle =
  title === 'Lumika Objetos'
    ? 'Lumika Objetos - Velas de soja y resina artesanal - Mar del Plata'
    : `${title} · Lumika Objetos`;

const ogImage = await getImage({
  src: image ?? brandOgImage,
  width: 1200,
  height: 630,
  format: 'jpeg',
  fit: 'cover',
});
const ogImageUrl = new URL(ogImage.src, Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#fff8d9" />
    <Font cssVariable="--font-stropica" preload />
    <Font cssVariable="--font-poppins" preload />
    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumika Objetos" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      Astro.url.pathname === '/' && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'WebSite',
            name: 'Lumika Objetos',
            url: Astro.site?.toString(),
            inLanguage: 'es-AR',
            publisher: { '@type': 'Organization', name: 'Lumika Objetos' },
          })}
        />
      )
    }

    {
      Astro.url.pathname === '/' && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Organization',
            name: 'Lumika Objetos',
            url: Astro.site?.toString(),
            logo: ogImageUrl,
            description:
              'Velas de soja y accesorios de resina, hechos a mano en Mar del Plata.',
            founder: [
              { '@type': 'Person', name: 'Abril' },
              { '@type': 'Person', name: 'Mailen' },
            ],
            sameAs: ['https://instagram.com/lumika.objetos'],
          })}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
