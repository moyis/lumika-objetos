---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  // LCP hero image to preload in <head>. Resolved to its AVIF srcset so the
  // browser starts fetching it during HTML parse instead of after discovering
  // the <img> in the body.
  preloadImage?: ImageMetadata;
  // Must match the hero <Picture> `sizes` so preload and render share one file.
  preloadSizes?: string;
}
const {
  title,
  description = 'Velas de soja y accesorios de resina hechos a mano en Mar del Plata. Piezas unicas en ediciones cortas. Compra por WhatsApp.',
  image,
  preloadImage,
  preloadSizes,
} = Astro.props;

// Same format/width/layout as the hero <Picture>, so getImage produces the
// identical hashed AVIF variants — the preload is a cache hit, not a 2nd fetch.
const heroPreload =
  preloadImage && preloadSizes
    ? await getImage({ src: preloadImage, format: 'avif', width: 1600, sizes: preloadSizes })
    : null;
const fullTitle =
  title === 'Lumika Objetos'
    ? 'Velas y decoración en Mar del Plata | Lumika Objetos'
    : `${title} · Lumika Objetos`;

// Pages with a specific image (products) get a cropped JPEG of it; everything
// else falls back to the curated 1200x630 brand card at /og-image.png.
const ogImageUrl = image
  ? new URL(
      (await getImage({ src: image, width: 1200, height: 630, format: 'jpeg', fit: 'cover' })).src,
      Astro.site,
    ).toString()
  : new URL('/og-image.png', Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#fff8d9" />
    <Font cssVariable="--font-stropica" preload />
    <Font cssVariable="--font-poppins" />
    {
      heroPreload && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          imagesrcset={heroPreload.srcSet.attribute}
          imagesizes={preloadSizes}
          fetchpriority="high"
        />
      )
    }
    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumika Objetos" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      Astro.url.pathname === '/' && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'WebSite',
            name: 'Lumika Objetos',
            url: Astro.site?.toString(),
            inLanguage: 'es-AR',
            publisher: { '@type': 'Organization', name: 'Lumika Objetos' },
          })}
        />
      )
    }

    {
      Astro.url.pathname === '/' && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Organization',
            name: 'Lumika Objetos',
            url: Astro.site?.toString(),
            logo: ogImageUrl,
            description: 'Velas de soja y accesorios de resina, hechos a mano en Mar del Plata.',
            founder: [
              { '@type': 'Person', name: 'Abril' },
              { '@type': 'Person', name: 'Mailen' },
            ],
            sameAs: ['https://instagram.com/lumika.objetos'],
          })}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded-full focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-skip focus:bg-[var(--color-ink)] focus:px-4 focus:py-2 focus:font-semibold focus:text-[var(--color-cream)]"
      >Saltar al contenido</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
