---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TagChips from '../../components/TagChips.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { sortProducts } from '../../lib/filterProducts';

const all = await getCollection('products');
const sorted = sortProducts(all);
const ogImage = sorted[0]?.data.images[0];

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tienda Lumika Objetos',
  numberOfItems: sorted.length,
  itemListElement: sorted.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/shop/${p.data.slug}`, Astro.site).toString(),
    name: p.data.title,
  })),
};
---

<Layout
  title="Tienda"
  description="Tienda de velas de soja artesanales y accesorios de resina hechos a mano en Mar del Plata. Piezas unicas en ediciones cortas."
  image={ogImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

  <section class="mx-auto max-w-[1400px] px-5 pt-10 pb-6">
    <span class="label">Tienda · {sorted.length} {sorted.length === 1 ? 'pieza' : 'piezas'}</span>
    <h1 class="display-2 mt-4">Todos los objetos.</h1>
  </section>

  <TagChips />

  <section class="mx-auto max-w-[1400px] px-5 py-10">
    <h2 class="sr-only">Productos</h2>
    <ProductGrid products={sorted} cols={4} priority />
  </section>
</Layout>
