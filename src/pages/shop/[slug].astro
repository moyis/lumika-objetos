---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import BuyButtons from '../../components/BuyButtons.astro';
import PriceDisplay from '../../components/PriceDisplay.astro';
import ProductCard from '../../components/ProductCard.astro';

export const getStaticPaths = (async () => {
  const all = await getCollection('products');
  return all.map((p) => ({
    params: { slug: p.data.slug },
    props: { product: p },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { Content } = await render(product);
const { title, slug, subtitle, price, stock, tags, images } = product.data;
const soldOut = stock === 0;
const primaryTag = tags[0];

const all = await getCollection('products');
const related = all
  .filter(
    (p) => p.data.slug !== product.data.slug && primaryTag && p.data.tags.includes(primaryTag),
  )
  .slice(0, 3);

const tagLabel: Record<string, string> = {
  velas: 'Velas',
  resina: 'Resina',
  nuevo: 'Nuevo',
  'edicion-limitada': 'Edición limitada',
};
---

<Layout title={title} description={subtitle ?? `${title} — Lumika Objetos`}>
  <div class="label mx-auto max-w-[1400px] px-5 pt-6">
    <a href="/shop">Tienda</a>
    {
      primaryTag && (
        <>
          {' '}
          / <a href={`/shop?tag=${primaryTag}`}>{tagLabel[primaryTag] ?? primaryTag}</a>
        </>
      )
    }
    <> / <span class="opacity-70">{title}</span></>
  </div>

  <article class="mx-auto grid max-w-[1400px] gap-10 px-5 pt-6 pb-16 md:grid-cols-[3fr_2fr]">
    <div>
      <ProductGallery images={images} alt={title} slug={slug} />
    </div>

    <aside class="self-start md:sticky md:top-24">
      {
        tags.length > 0 && (
          <ul class="mb-4 flex flex-wrap gap-2">
            {tags.map((t) => (
              <li>
                <a
                  href={`/shop?tag=${t}`}
                  class="label inline-block rounded-full border border-[var(--color-ink)] px-3 py-1"
                >
                  {tagLabel[t] ?? t}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <h1 class="display-2" transition:name={`product-title-${slug}`}>
        <span class="wavy-underline">{title}</span>
      </h1>
      {subtitle && <p class="mt-3 text-lg opacity-80">{subtitle}</p>}

      <div class="mt-6 flex items-baseline gap-3">
        <span transition:name={`product-price-${slug}`}>
          <PriceDisplay value={price} size="lg" />
        </span>
        {
          soldOut && (
            <span class="label rounded bg-[var(--color-ink)] px-2 py-1 text-[var(--color-cream)]">
              Agotado
            </span>
          )
        }
      </div>

      <BuyButtons productTitle={title} disabled={soldOut} />

      <div class="prose prose-neutral mt-8 max-w-none text-base leading-relaxed">
        <Content />
      </div>
    </aside>
  </article>

  {
    related.length > 0 && (
      <section class="border-t-2 border-[var(--color-ink)]">
        <div class="mx-auto max-w-[1400px] px-5 py-12">
          <h2 class="h2 mb-6">También te puede gustar</h2>
          <div class="grid grid-cols-2 gap-6 md:grid-cols-3">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
