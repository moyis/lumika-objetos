---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import BuyButtons from '../../components/BuyButtons.astro';
import PriceDisplay from '../../components/PriceDisplay.astro';
import ProductCard from '../../components/ProductCard.astro';
import { TAG_LABELS } from '../../lib/productTags';

export const getStaticPaths = (async () => {
  const all = await getCollection('products');
  return all.map((p) => ({
    params: { slug: p.data.slug },
    props: { product: p },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { Content } = await render(product);
const { title, slug, subtitle, price, stock, tags, images, fragrances } = product.data;
const soldOut = stock === 0;

const bodyText = product.body
  ?.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
  .replace(/[#*_>`~]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const ogDescription = bodyText
  ? bodyText.length > 160
    ? `${bodyText.slice(0, 157).trimEnd()}…`
    : bodyText
  : (subtitle ?? `${title} — Lumika Objetos`);
const primaryTag = tags[0];

// Prefer the curated subtitle for the social/meta description; fall back to body text.
const metaDescription = subtitle?.trim() ? subtitle : ogDescription;

const category =
  primaryTag === 'velas' ? 'Velas' : primaryTag === 'resina' ? 'Resina' : 'Objetos artesanales';

const isCandle = tags.includes('velas');
const isResin = tags.includes('resina');
const material =
  isCandle && !isResin ? 'Cera de soja' : isResin && !isCandle ? 'Resina' : undefined;

const priceValidUntil = new Date(new Date().setFullYear(new Date().getFullYear() + 1))
  .toISOString()
  .split('T')[0];

const all = await getCollection('products');
const related = all
  .filter(
    (p) => p.data.slug !== product.data.slug && primaryTag && p.data.tags.includes(primaryTag),
  )
  .slice(0, 3);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const shopUrl = new URL('/shop', Astro.site).toString();

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description: ogDescription,
  image: images.map((img) => new URL(img.src, Astro.site).toString()),
  sku: product.data.sku ?? slug,
  brand: { '@type': 'Brand', name: 'Lumika Objetos' },
  itemCondition: 'https://schema.org/NewCondition',
  category,
  ...(material ? { material } : {}),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'ARS',
    price,
    priceValidUntil,
    availability: soldOut ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
    url: canonicalUrl,
  },
};

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Tienda', item: shopUrl },
  ...(primaryTag
    ? [
        {
          '@type': 'ListItem',
          position: 2,
          name: TAG_LABELS[primaryTag] ?? primaryTag,
          item: new URL(`/shop?tag=${primaryTag}`, Astro.site).toString(),
        },
      ]
    : []),
  {
    '@type': 'ListItem',
    position: primaryTag ? 3 : 2,
    name: title,
    item: canonicalUrl,
  },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};
---

<Layout title={title} description={metaDescription} image={images[0]}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="label mx-auto max-w-[1400px] px-5 pt-6">
    <a href="/shop">Tienda</a>
    {
      primaryTag && (
        <>
          {' '}
          / <a href={`/shop?tag=${primaryTag}`}>{TAG_LABELS[primaryTag] ?? primaryTag}</a>
        </>
      )
    }
    <> / <span class="opacity-70">{title}</span></>
  </div>

  <article class="mx-auto grid max-w-[1400px] gap-10 px-5 pt-6 pb-16 md:grid-cols-[3fr_2fr]">
    <div>
      <ProductGallery images={images} alt={title} />
    </div>

    <aside class="self-start md:sticky md:top-24">
      {
        tags.length > 0 && (
          <ul class="mb-4 flex flex-wrap gap-2">
            {tags.map((t) => (
              <li>
                <a
                  href={`/shop?tag=${t}`}
                  class="label inline-block rounded-full border border-[var(--color-ink)] px-3 py-1"
                >
                  {TAG_LABELS[t] ?? t}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <h1 class="display-2">
        <span class="wavy-underline">{title}</span>
      </h1>
      {subtitle && <p class="mt-3 text-lg opacity-80">{subtitle}</p>}

      <div class="mt-6 flex items-baseline gap-3">
        <PriceDisplay value={price} size="lg" />
        {
          soldOut && (
            <span class="label rounded bg-[var(--color-ink)] px-2 py-1 text-[var(--color-cream)]">
              Agotado
            </span>
          )
        }
      </div>

      <BuyButtons productTitle={title} disabled={soldOut} fragrances={fragrances} />

      <div class="prose prose-neutral mt-8 max-w-none text-base leading-relaxed">
        <Content />
      </div>
    </aside>
  </article>

  {
    related.length > 0 && (
      <section class="border-t-2 border-[var(--color-ink)]">
        <div class="mx-auto max-w-[1400px] px-5 py-12">
          <h2 class="h2 mb-6">También te puede gustar</h2>
          <div class="grid grid-cols-2 gap-6 md:grid-cols-3">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
