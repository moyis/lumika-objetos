---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import BuyButtons from '../../components/BuyButtons.astro';
import PriceDisplay from '../../components/PriceDisplay.astro';
import ProductCard from '../../components/ProductCard.astro';

export const getStaticPaths = (async () => {
  const all = await getCollection('products');
  return all.map((p) => ({
    params: { slug: p.data.slug },
    props: { product: p },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { Content } = await render(product);
const { title, subtitle, price, stock, tags, images } = product.data;
const soldOut = stock === 0;
const primaryTag = tags[0];

const all = await getCollection('products');
const related = all
  .filter((p) => p.data.slug !== product.data.slug && primaryTag && p.data.tags.includes(primaryTag))
  .slice(0, 3);

const tagLabel: Record<string, string> = {
  velas: 'Velas',
  resina: 'Resina',
  nuevo: 'Nuevo',
  'edicion-limitada': 'Edición limitada',
};
---
<Layout title={title} description={subtitle ?? `${title} — Lumika Objetos`}>
  <div class="max-w-[1400px] mx-auto px-5 pt-6 label">
    <a href="/shop">Tienda</a>
    {primaryTag && <> / <a href={`/shop?tag=${primaryTag}`}>{tagLabel[primaryTag] ?? primaryTag}</a></>}
    <> / <span class="opacity-70">{title}</span></>
  </div>

  <article class="max-w-[1400px] mx-auto px-5 pt-6 pb-16 grid gap-10 md:grid-cols-[3fr_2fr]">
    <div>
      <ProductGallery images={images} alt={title} />
    </div>

    <aside class="md:sticky md:top-24 self-start">
      {tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 mb-4">
          {tags.map((t) => (
            <li>
              <a href={`/shop?tag=${t}`} class="inline-block label border border-[var(--color-ink)] rounded-full px-3 py-1">
                {tagLabel[t] ?? t}
              </a>
            </li>
          ))}
        </ul>
      )}

      <h1 class="display-2"><span class="wavy-underline">{title}</span></h1>
      {subtitle && <p class="mt-3 text-lg opacity-80">{subtitle}</p>}

      <div class="mt-6 flex items-baseline gap-3">
        <PriceDisplay value={price} size="lg" />
        {soldOut && (
          <span class="bg-[var(--color-ink)] text-[var(--color-cream)] label px-2 py-1 rounded">Agotado</span>
        )}
      </div>

      <BuyButtons productTitle={title} disabled={soldOut} />

      <div class="prose prose-neutral mt-8 max-w-none text-base leading-relaxed">
        <Content />
      </div>
    </aside>
  </article>

  {related.length > 0 && (
    <section class="border-t-2 border-[var(--color-ink)]">
      <div class="max-w-[1400px] mx-auto px-5 py-12">
        <h2 class="h2 mb-6">También te puede gustar</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</Layout>
