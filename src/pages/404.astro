---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada"
  description="No encontramos lo que estabas buscando. Volvé al inicio o pasá por la tienda de Lumika Objetos."
>
  <section class="mx-auto max-w-[1100px] px-5 py-16">
    <span class="label">Error 404</span>
    <h1 class="display-1 mt-6">
      Esta página<br />
      <em class="text-[var(--color-link)] italic">se nos perdió.</em>
    </h1>
    <p class="mt-8 max-w-[60ch] text-lg leading-relaxed">
      Quizás escribiste mal el link, o esta pieza ya no está. Pasá por la tienda para ver lo que
      tenemos hoy, o volvé al inicio.
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/shop"
        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-blue)] px-6 py-3 font-semibold tracking-wide text-[var(--color-cream-fixed)]"
        >Ver la tienda →</a
      >
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full border-2 border-[var(--color-ink)] px-6 py-3 font-semibold tracking-wide text-[var(--color-ink)]"
        >Volver al inicio</a
      >
    </div>
  </section>
</Layout>
