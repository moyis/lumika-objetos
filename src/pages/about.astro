---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import introImage from '../assets/images/vela-y-accesorios.webp';
import studioImage from '../assets/images/vela-muffin-limon-y-aritos.webp';

const steps = [
  {
    num: '01',
    title: 'Diseño',
    body: 'Cada pieza empieza en papel. Probamos formas, esencias, colores hasta dar con algo que valga la pena verter.',
  },
  {
    num: '02',
    title: 'Vertido',
    body: 'Cera de soja calentada al punto justo, o resina mezclada y desgasificada. Una pieza por vez. Sin moldes industriales.',
  },
  {
    num: '03',
    title: 'Curado',
    body: 'Las velas reposan días para fijar la fragancia. La resina cura sin apuro hasta quedar firme y transparente.',
  },
];
---

<Layout title="Sobre Lumika">
  <section class="mx-auto max-w-[1100px] px-5 py-16">
    <span class="label">Sobre Lumika</span>
    <h1 class="display-1 mt-6">
      Objetos de mano,<br />
      <em class="text-[var(--color-blue)] italic">con tiempo.</em>
    </h1>
    <p class="mt-8 max-w-[60ch] text-lg leading-relaxed">
      Lumika Objetos es un estudio chico en Mar del Plata. Hacemos velas de soja y accesorios de
      resina, en ediciones cortas y a mano. Cada pieza es única — los pequeños desniveles, las
      burbujas, el color que cambia un poco entre tandas, son parte.
    </p>

    <Image
      src={introImage}
      alt="Vela Lumika con accesorios de resina"
      widths={[600, 900, 1200]}
      sizes="(min-width: 768px) 1100px, 100vw"
      class="mt-12 aspect-[16/9] w-full rounded-md border-2 border-[var(--color-ink)] object-cover"
    />
  </section>

  <section class="border-y-2 border-[var(--color-ink)] bg-[var(--color-blush)]/40">
    <div class="mx-auto grid max-w-[1400px] gap-10 px-5 py-16 md:grid-cols-3">
      {
        steps.map((s) => (
          <div>
            <div class="label">{s.num}</div>
            <h3 class="h2 mt-3">{s.title}</h3>
            <p class="mt-3 leading-relaxed">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[1100px] px-5 py-16">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div>
        <h2 class="display-2">Quiénes somos.</h2>
        <p class="mt-6 max-w-[60ch] text-lg leading-relaxed">
          Dos manos, una mesa, mucha luz. Cada tanda lleva el ritmo de quien la hace. Si tenés una
          idea para una pieza única en resina, hablanos.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-[var(--color-blue)] px-6 py-3 font-semibold tracking-wide text-[var(--color-cream)]"
          >Hablemos →</a
        >
      </div>
      <Image
        src={studioImage}
        alt="Vela Lumika de limón con aritos de resina"
        widths={[400, 600, 800]}
        sizes="(min-width: 768px) 45vw, 100vw"
        class="aspect-square w-full rounded-md border-2 border-[var(--color-ink)] object-cover"
      />
    </div>
  </section>

  <section class="border-t-2 border-[var(--color-ink)]">
    <div class="mx-auto max-w-[1100px] px-5 py-16">
      <span class="label">Quien hace</span>
      <h2 class="display-2 mt-4">Las manos detrás.</h2>
      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <article>
          <h3 class="h2 mt-5">Abril</h3>
          <p class="label mt-1 opacity-70">Co-fundadora · Velas</p>
          <p class="mt-4 leading-relaxed">
            Lorem ipsum dolor sit amet consectetur, adipisicing elit. Quas excepturi, tempora
            molestias est cumque omnis fugiat, similique itaque recusandae voluptatibus iusto
            pariatur quod voluptatem. Iusto quae laudantium officia excepturi cum? Lorem ipsum
            dolor, sit amet consectetur adipisicing elit. Earum sed, placeat ipsum natus excepturi,
            aut, sint nihil dignissimos minus repudiandae obcaecati reiciendis adipisci ab sequi
            consectetur? Repudiandae explicabo natus laborum.
          </p>
        </article>
        <article>
          <h3 class="h2 mt-5">Mailen</h3>
          <p class="label mt-1 opacity-70">Co-fundadora · Resina</p>
          <p class="mt-4 leading-relaxed">
            Lorem ipsum dolor sit, amet consectetur adipisicing elit. Excepturi deleniti eligendi
            vero molestiae in? Totam et esse ipsa ex eum, minima quidem eveniet natus molestiae
            deleniti sit, culpa accusamus omnis. Lorem ipsum dolor sit amet consectetur adipisicing
            elit. Velit debitis inventore deserunt! Ut nobis saepe omnis deleniti deserunt aperiam.
            Sit unde perspiciatis accusantium adipisci? Itaque nostrum et esse facilis provident.
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>
